{
  "name": "yargpt-desktop",
  "productName": "YarGPT",
  "version": "0.1.0",
  "private": true,
  "description": "YarGPT for macOS",
  "author": "Yar Kravtsov",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "build": "electron-builder --mac",
    "build:universal": "electron-builder --mac zip --universal --publish never",
    "test": "node --test"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.yarlson.yargpt",
    "files": [
      "main.js",
      "app.js",
      "bridge.js",
      "bridge-window.js",
      "bridge-preload.js",
      "bridge.html",
      "bridge-page.js",
      "bridge.css",
      "context-menu.js",
      "menu.js",
      "preload.js",
      "server-log.js",
      "settings-bridge.js",
      "updater.js",
      "updater-state.js",
      "updater-io.js"
    ],
    "extraResources": [{ "from": "../bin/yargpt", "to": "yargpt" }],
    "extraFiles": [
      {
        "from": "build/dev.yarlson.yargpt.server.plist",
        "to": "Library/LaunchAgents/dev.yarlson.yargpt.server.plist"
      }
    ],
    "protocols": [{ "name": "YarGPT", "schemes": ["yargpt"] }],
    "publish": [{ "provider": "generic", "url": "https://github.com/yarlson/yargpt/releases/latest/download/", "channel": "latest" }],
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "directories": { "output": "dist" }
  }
}
