---
interface Props {
	/** Prefix for the SVG ids, unique on the page. */
	id: string;
	/** CSS length for the side of the tile. */
	size: string;
	/** Play the entrance, the brow raise and the lens glint once on load. */
	intro?: boolean;
}

const { id, size, intro = false } = Astro.props;
const lenses = `${id}-lenses`;
const lensFill = `${id}-lens-fill`;
const glintFill = `${id}-glint-fill`;
---

<div class:list={["mark", { intro }]} style={`--mark-size: ${size}`} aria-hidden="true">
	<svg viewBox="0 0 64 64">
		<defs>
			<clipPath id={lenses}>
				<rect x="12" y="32" width="14" height="9" rx="1"></rect>
				<rect x="38" y="32" width="14" height="9" rx="1"></rect>
			</clipPath>
			<linearGradient id={lensFill} x1="0" x2="0" y1="0" y2="1">
				<stop offset="0" stop-color="#fff" stop-opacity=".2"></stop>
				<stop offset=".55" stop-color="#fff" stop-opacity=".05"></stop>
				<stop offset="1" stop-color="#fff" stop-opacity=".02"></stop>
			</linearGradient>
			<linearGradient id={glintFill} x1="0" x2="1" y1="0" y2="0">
				<stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
				<stop offset=".5" stop-color="#fff" stop-opacity=".75"></stop>
				<stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
			</linearGradient>
		</defs>
		<g class="glasses">
			<g clip-path={`url(#${lenses})`}>
				<rect x="0" y="32" width="64" height="9" fill={`url(#${lensFill})`}></rect>
				<polygon class="glint" points="-8,28 4,28 -4,46 -16,46" fill={`url(#${glintFill})`}></polygon>
			</g>
			<g fill="none" stroke="#fff" stroke-width="5" stroke-linejoin="round">
				<rect x="9.5" y="29.5" width="19" height="14" rx="3"></rect>
				<rect x="35.5" y="29.5" width="19" height="14" rx="3"></rect>
				<path d="M28.5 35.5H35.5"></path>
			</g>
		</g>
		<g class="brow-lift">
			<path class="brow" d="M37.5 22L53 16.5" stroke="#db2777" stroke-width="5.5"></path>
		</g>
	</svg>
</div>

<style>
	.mark {
		position: relative;
		flex: none;
		width: var(--mark-size);
		height: var(--mark-size);
		border-radius: 21.875%;
		background:
			radial-gradient(40% 32% at 74% 26%, rgb(219 39 119 / 20%) 0%, rgb(219 39 119 / 0%) 100%),
			radial-gradient(70% 34% at 50% 104%, rgb(255 255 255 / 9%) 0%, rgb(255 255 255 / 0%) 100%),
			linear-gradient(180deg, #1a1a1a 0%, #121212 55%, #161616 100%);
		box-shadow:
			0 1px 2px rgb(0 0 0 / 20%),
			0 calc(var(--mark-size) * 0.13) calc(var(--mark-size) * 0.29) calc(var(--mark-size) * -0.13) rgb(0 0 0 / 55%);
	}

	/* The edge light of the glass: a gradient ring, masked to the border box. */
	.mark::before {
		content: "";
		position: absolute;
		inset: 0;
		padding: max(1px, calc(var(--mark-size) * 0.011));
		border-radius: inherit;
		pointer-events: none;
		background: linear-gradient(
			155deg,
			rgb(255 255 255 / 60%) 0%,
			rgb(255 255 255 / 12%) 30%,
			rgb(255 255 255 / 0%) 55%,
			rgb(255 255 255 / 16%) 80%,
			rgb(255 255 255 / 40%) 100%
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box exclude,
			linear-gradient(#000 0 0);
	}

	.mark::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		pointer-events: none;
		background: linear-gradient(170deg, rgb(255 255 255 / 10%) 0%, rgb(255 255 255 / 2%) 38%, rgb(255 255 255 / 0%) 50%);
	}

	svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	/* The motion ends within 5 seconds: WCAG 2.2.2 requires a pause control for longer automatic motion. */
	.intro {
		animation: glass-mark-in 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.intro .glasses {
		animation: glass-mark-glasses 1.4s ease-in-out 1.2s;
	}

	.brow-lift,
	.brow {
		transform-box: fill-box;
		transform-origin: 0% 100%;
	}

	.brow-lift {
		transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.intro .brow {
		animation:
			glass-mark-brow-in 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.25s both,
			glass-mark-brow 1.4s ease-in-out 1.2s;
	}

	.intro .glint {
		animation: glass-mark-glint 1.1s ease-in-out 2.4s;
	}

	@keyframes glass-mark-in {
		from {
			opacity: 0;
			transform: translateY(8px) scale(0.97);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes glass-mark-brow-in {
		from {
			opacity: 0;
			transform: translateY(-7px) rotate(-10deg);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes glass-mark-brow {
		0%,
		100% {
			transform: none;
		}
		25%,
		70% {
			transform: translateY(-3.2px) rotate(-7deg);
		}
	}

	@keyframes glass-mark-glasses {
		0%,
		100% {
			transform: none;
		}
		25%,
		70% {
			transform: translateY(-0.8px);
		}
	}

	@keyframes glass-mark-glint {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(80px);
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.mark:hover .brow-lift {
			transform: translateY(-3px) rotate(-6deg);
		}
	}

	@media (forced-colors: active) {
		.mark {
			forced-color-adjust: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.intro,
		.intro .glasses,
		.intro .brow,
		.intro .glint {
			animation: none;
		}

		.brow-lift,
		.mark:hover .brow-lift {
			transition: none;
			transform: none;
		}
	}
</style>
