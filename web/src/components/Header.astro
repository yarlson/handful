---
import GithubMark from "./GithubMark.astro";
import Mark from "./Mark.astro";
---

<div class="mx-auto w-full max-w-6xl px-6 sm:px-10 lg:px-16">
	<header class="flex items-center justify-between py-5 lg:py-8">
		<a href="/" class="inline-flex items-center gap-2.5 text-[0.9375rem] font-semibold tracking-[-0.01em]">
			<Mark id="header-mark" size="1.375rem" />
			<span class="text-[1.9375rem] font-semibold leading-none tracking-[-0.04em]">handful</span>
		</a>
		<nav aria-label="Main" class="flex items-center gap-6">
			<a href="/docs/" class="text-[0.9375rem] text-ink-2 transition-colors hover:text-ink">Docs</a>
			<a href="https://github.com/yarlson/handful" class="inline-flex items-center gap-2 text-[0.9375rem] text-ink-2 transition-colors hover:text-ink">
				<GithubMark />
				GitHub
			</a>
		</nav>
	</header>
</div>
