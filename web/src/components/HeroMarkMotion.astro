<!--
  Motion for the hero mark (the 64-unit tile with eyes that Mark.astro renders with id "hero-mark").
  Place it right after that mark: it runs inline before the first paint, so the static logo never flashes.
  Intro, once per session: the dots pop in and wander, the lead turns pink and takes its place, the others gather (2.35 s).
  Idle: after 9 s with no input, one small moment; at least 25 s apart and at most 3, only while the mark is on
  screen and the tab is visible. prefers-reduced-motion: nothing runs and the static logo stays.
  Only SVG attributes change, so the layout never moves. Each animation ends by restoring every attribute
  to its exact original value, so the logo lands pixel-exact.
-->
<script is:inline>
(() => {
	const mask = document.getElementById("hero-mark-eyes");
	if (!mask || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
	const svg = mask.closest("svg"), dots = [...svg.querySelectorAll("g[mask] circle")], eyes = [...mask.querySelectorAll("ellipse")];
	const saved = [...dots, ...eyes].map((n) => [n, ["cx", "cy", "r", "ry", "fill"].filter((a) => n.hasAttribute(a)).map((a) => [a, n.getAttribute(a)])]);
	const restore = () => saved.forEach(([n, as]) => as.forEach(([a, v]) => n.setAttribute(a, v)));
	const num = (n, a) => +n.getAttribute(a), R = 6.5, DT = 1 / 240, MASS = [1.3, 1, 1, 1, 1];
	const HOME = dots.map((d) => [num(d, "cx"), num(d, "cy")]);
	// the logo's own gaze: the centre of each eye pair, relative to its dot
	const LOOK = HOME.map(([x, y], i) => [(num(eyes[2 * i], "cx") + num(eyes[2 * i + 1], "cx")) / 2 - x, num(eyes[2 * i], "cy") - y]);
	const D = HOME.map(([x, y], i) => ({ x, y, vx: 0, vy: 0, ax: 0, ay: 0, s: 1, sv: 0, gx: LOOK[i][0], gy: LOOK[i][1], gvx: 0, gvy: 0 }));
	const seg = (t, a, b) => Math.min(1, Math.max(0, (t - a) / (b - a)));
	const blinkAt = (t, at) => 1 - 0.95 * Math.sin(Math.PI * seg(t, at, at + 0.16));
	const toward = (d, x, y, amt = 1.1) => { const dx = x - d.x, dy = y - d.y, l = Math.hypot(dx, dy) || 1; return [(dx / l) * amt, (dy / l) * amt * 0.8]; };

	// one physics step: springs to targets (the lead is heavier), round collisions, eyes that trail, a pop-in scale
	function step({ target, k = 130, zeta = 0.62, gaze = (i) => LOOK[i], scale = () => 1, free }) {
		D.forEach((d, i) => {
			const m = MASS[i], c = 2 * zeta * Math.sqrt(k * m), [tx, ty] = target(i);
			if (!(free && free(i, d))) { d.ax = (k * (tx - d.x) - c * d.vx) / m; d.ay = (k * (ty - d.y) - c * d.vy) / m; d.vx += d.ax * DT; d.vy += d.ay * DT; }
			d.x = Math.min(64 - R - 1.5, Math.max(R + 1.5, d.x + d.vx * DT)); d.y = Math.min(64 - R - 1.5, Math.max(R + 1.5, d.y + d.vy * DT));
			d.sv += (380 * (scale(i) - d.s) - 2 * 0.45 * Math.sqrt(380) * d.sv) * DT; d.s += d.sv * DT;
			const [gx, gy] = gaze(i, d), ek = 520, ec = 2 * 0.55 * Math.sqrt(ek);
			d.gvx += (ek * (gx - d.gx) - ec * d.gvx - d.ax * 0.02) * DT; d.gvy += (ek * (gy - d.gy) - ec * d.gvy - d.ay * 0.02) * DT;
			d.gx += d.gvx * DT; d.gy += d.gvy * DT;
		});
		for (let i = 0; i < 5; i++) for (let j = i + 1; j < 5; j++) {
			const a = D[i], b = D[j], dx = b.x - a.x, dy = b.y - a.y, dist = Math.hypot(dx, dy), min = R * (Math.max(0, a.s) + Math.max(0, b.s));
			if (dist >= min || !dist) continue;
			const nx = dx / dist, ny = dy / dist, ia = 1 / MASS[i], ib = 1 / MASS[j], o = (min - dist) / (ia + ib);
			a.x -= nx * o * ia; a.y -= ny * o * ia; b.x += nx * o * ib; b.y += ny * o * ib;
			const vr = (b.vx - a.vx) * nx + (b.vy - a.vy) * ny;
			if (vr < 0) { const J = (-1.35 * vr) / (ia + ib); a.vx -= J * ia * nx; a.vy -= J * ia * ny; b.vx += J * ib * nx; b.vy += J * ib * ny; }
		}
	}
	function draw(blink = () => 1, pink = 1) {
		D.forEach((d, i) => {
			const s = Math.max(0, d.s);
			dots[i].setAttribute("cx", d.x.toFixed(2)); dots[i].setAttribute("cy", d.y.toFixed(2)); dots[i].setAttribute("r", (R * s).toFixed(2));
			[-2.3, 2.3].forEach((ex, e) => {
				const n = eyes[2 * i + e];
				n.setAttribute("cx", (d.x + (ex + d.gx) * s).toFixed(2)); n.setAttribute("cy", (d.y + d.gy * s).toFixed(2));
				n.setAttribute("ry", s > 0.6 ? (1.9 * blink(i) * s).toFixed(2) : "0");
			});
		});
		dots[0].setAttribute("fill", pink >= 1 ? "#e60076" : `rgb(${Math.round(255 - 25 * pink)} ${Math.round(255 * (1 - pink))} ${Math.round(255 - 137 * pink)})`);
	}
	// run(tick): real-time frames, fixed 240 Hz steps; tick(t) returns false when done. A hidden tab ends it at once.
	let busy = false;
	function run(tick) {
		busy = true; let t = 0, t0, done = false;
		const frame = (now) => {
			t0 ??= now;
			while (!done && !document.hidden && t < (now - t0) / 1000) { t += DT; done = tick(t) === false; }
			if (done || document.hidden) { restore(); D.forEach((d, i) => Object.assign(d, { x: HOME[i][0], y: HOME[i][1], vx: 0, vy: 0, s: 1, sv: 0, gx: LOOK[i][0], gy: LOOK[i][1], gvx: 0, gvy: 0 })); busy = false; return; }
			requestAnimationFrame(frame);
		};
		requestAnimationFrame(frame);
	}

	// ---- intro, once per session ----
	let played = true;
	try { played = sessionStorage.getItem("hf-hero-intro") === "1"; sessionStorage.setItem("hf-hero-intro", "1"); } catch {}
	if (!played) {
		const START = [[46, 46], [17, 19], [45, 17], [18, 46], [31, 32]];
		const wander = (i, t) => [START[i][0] + 4.5 * Math.sin(2.1 * t + i * 1.9), START[i][1] + 4 * Math.cos(1.8 * t + i * 1.3)];
		const goHome = (i) => (i === 0 ? 1.05 : 1.25 + i * 0.06); // the lead takes its place first, the others follow
		D.forEach((d, i) => { [d.x, d.y] = wander(i, 0); d.s = 0; d.gx = 0; d.gy = 0.3; });
		draw(() => 1, 0); // the first paint already shows the scattered start
		run((t) => {
			if (t > 2.35) return false;
			const lead = t >= goHome(0);
			step({
				target: (i) => (t >= goHome(i) ? HOME[i] : wander(i, t)),
				k: lead ? 130 : 45, zeta: lead ? 0.62 : 0.5,
				scale: (i) => (t > 0.05 + i * 0.07 ? 1 : 0),
				gaze: (i, d) => {
					if (t > 2.0) return LOOK[i];
					if (t > 1.0) return i === 0 ? [0.2, 0.5] : toward(d, D[0].x, D[0].y);
					const sp = Math.hypot(d.vx, d.vy); return sp > 4 ? [d.vx / sp, (d.vy / sp) * 0.8] : [0, 0.3];
				},
			});
			draw((i) => (i === 0 ? blinkAt(t, 0.98) : blinkAt(t, 1.95 + i * 0.04)), seg(t, 0.92, 1.12));
		});
	}

	// ---- idle moments ----
	const ORDER = [1, 3, 0, 2, 4]; // left-to-right rank of each dot
	let pointer = null;
	const moments = [
		// 1. a blink ripple, left to right
		(t) => { if (t > 0.95) return false; step({ target: (i) => HOME[i] }); draw((i) => blinkAt(t, 0.1 + ORDER[i] * 0.09)); },
		// 2. the top-right dot hops and lands a little off; the lead looks, then nudges it back into place
		(() => { let landed = false, hopped = false;
			return (t) => {
				if (t > 1.7) return false;
				const d1 = D[1];
				if (t >= 0.15 && !hopped) { hopped = true; d1.vy = -70; d1.vx = -14; }
				step({
					target: (i) => (i === 0 && t > 0.55 && t < 0.72 ? [HOME[0][0] + 3.6, HOME[0][1]] : HOME[i]),
					free: (i, d) => {
						if (i !== 1 || t < 0.15 || t > 0.62) return false;
						if (!landed) { d.vy += 900 * DT; d.ax = 0; d.ay = 900; if (d.y >= HOME[1][1] && d.vy > 0) { d.y = HOME[1][1]; d.vy = 0; d.vx = 0; landed = true; } }
						else if (Math.abs(d.vx) < 1) { d.vx = 0; d.vy = 0; d.ax = d.ay = 0; }
						return true;
					},
					gaze: (i, d) => {
						if (t > 1.15) return LOOK[i];
						if (i === 1) return t < 0.35 ? [0, -1.1] : t < 0.62 ? toward(d, D[0].x, D[0].y) : [0.3, 0.4];
						return t > 0.12 ? toward(d, d1.x, d1.y) : LOOK[i];
					},
				});
				draw((i) => (i === 1 ? blinkAt(t, 0.42) : 1));
			};
		})(),
		// 3. everyone glances at the pointer (or down at the button on touch screens), blinks, and looks back
		(t) => {
			if (t > 1.5) return false;
			const b = svg.getBoundingClientRect(), u = 64 / b.width;
			const at = pointer ? [(pointer[0] - b.left) * u, (pointer[1] - b.top) * u] : [32, 200];
			step({ target: (i) => HOME[i], gaze: (i, d) => (t > 0.1 && t < 1.05 ? toward(d, at[0], at[1], 1.2) : LOOK[i]) });
			draw((i) => blinkAt(t, 0.62 + ORDER[i] * 0.03));
		},
	];
	let count = 0, lastInput = performance.now(), lastMoment = -Infinity, onScreen = true;
	const wake = (e) => { lastInput = performance.now(); if (e.clientX !== undefined && e.pointerType === "mouse") pointer = [e.clientX, e.clientY]; };
	["pointermove", "pointerdown", "keydown", "wheel", "touchstart", "scroll"].forEach((ev) => addEventListener(ev, wake, { passive: true }));
	new IntersectionObserver(([e]) => (onScreen = e.isIntersecting)).observe(svg);
	const timer = setInterval(() => {
		const now = performance.now();
		if (busy || !onScreen || document.hidden || now - lastInput < 9000 || now - lastMoment < 25000) return;
		run(moments[count]); lastMoment = now; count += 1;
		if (count === moments.length) clearInterval(timer);
	}, 500);
})();
</script>
