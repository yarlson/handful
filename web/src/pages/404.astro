---
import Layout from "../layouts/Layout.astro";
import Mark from "../components/Mark.astro";
---

<Layout title="Page not found · Handful" description="This page does not exist on handful.dev.">
	<meta slot="head" name="robots" content="noindex" />
	<main class="mx-auto flex min-h-dvh w-full max-w-6xl flex-col items-center justify-center gap-6 px-6 text-center">
		<Mark id="missing-mark" size="4.5rem" variant="tile-small" />
		<h1 class="text-balance text-[clamp(1.875rem,3.6vw,2.875rem)] font-[560] leading-[1.1] tracking-[-0.035em]">This page wandered off.</h1>
		<a
			href="/"
			class="inline-flex min-h-12 items-center justify-center rounded-[0.625rem] border border-line-strong px-5 text-[0.9375rem] font-[550] transition-colors hover:bg-hover active:bg-pressed"
		>
			Back to the others
		</a>
	</main>
</Layout>
