---
import Docs from "../../layouts/Docs.astro";
import { pages } from "../../docs";
---

<Docs title="Docs" description="How Handful works: running a software team, bots and rooms, teams, the window, phone access, connectors, settings and the Mac app.">
	<div class="docs">
		<h1>Handful docs</h1>
		<p>How Handful works, page by page. Start with First steps.</p>
		<ul class="!mt-8 !list-none !pl-0 space-y-6">
			{
				pages.map((page) => (
					<li>
						<a href={`/docs/${page.slug}/`} class="text-lg font-[560] tracking-[-0.015em]">{page.title}</a>
						<p class="!mt-1 !text-base !text-ink-2">{page.description}</p>
					</li>
				))
			}
		</ul>
		<p class="!mt-10 !text-base !text-ink-2">
			Also: <a href="/security/">Security and data</a> says what leaves your computer. <a href="/built-with-handful/">How Handful builds Handful</a> shows the teams that make it.
		</p>
	</div>
</Docs>
