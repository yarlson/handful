---
import Layout from "../layouts/Layout.astro";
import Mark from "../components/Mark.astro";
import HeroMarkMotion from "../components/HeroMarkMotion.astro";
import Install from "../components/Install.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Proofs from "../components/Proofs.astro";
import Shot from "../components/Shot.astro";
import { macDownloadUrl } from "../release";
import { aboutText, needs } from "../about";
import teamLight from "../assets/team-light.png";
import teamDark from "../assets/team-dark.png";
import teamMLight from "../assets/team-m-light.png";
import teamMDark from "../assets/team-m-dark.png";
import inboxLight from "../assets/inbox-light.png";
import inboxDark from "../assets/inbox-dark.png";
import inboxMLight from "../assets/inbox-m-light.png";
import inboxMDark from "../assets/inbox-m-dark.png";
import reviewLight from "../assets/review-light.png";
import reviewDark from "../assets/review-dark.png";
import approvalLight from "../assets/approval-light.png";
import approvalDark from "../assets/approval-dark.png";
import approvalMLight from "../assets/approval-m-light.png";
import approvalMDark from "../assets/approval-m-dark.png";
import needsYouLight from "../assets/needs-you-light.png";
import needsYouDark from "../assets/needs-you-dark.png";
import needsYouMLight from "../assets/needs-you-m-light.png";
import needsYouMDark from "../assets/needs-you-m-dark.png";
import botLight from "../assets/bot-light.png";
import botDark from "../assets/bot-dark.png";
import botMLight from "../assets/bot-m-light.png";
import botMDark from "../assets/bot-m-dark.png";

const title = "Handful: a small team of AI agents that builds and reviews code. You approve.";
const description =
	"Handful is an open-source app for Mac and Linux. Give a team of bots a task: a lead splits it into steps, the members do them, another member can review each step, and you approve the result. It runs Claude Code on your own machine and your own subscription.";
const site = Astro.site?.origin ?? "https://handful.dev";
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{ "@type": "WebSite", "@id": `${site}/#website`, name: "Handful", alternateName: "handful.dev", url: `${site}/` },
		{
			"@type": "SoftwareApplication",
			"@id": `${site}/#app`,
			name: "Handful",
			description: aboutText,
			url: `${site}/`,
			applicationCategory: "DeveloperApplication",
			operatingSystem: "macOS, Linux",
			softwareRequirements: needs,
			downloadUrl: macDownloadUrl,
			license: "https://opensource.org/licenses/MIT",
			isAccessibleForFree: true,
			offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
			sameAs: "https://github.com/yarlson/handful",
			softwareHelp: { "@type": "CreativeWork", url: `${site}/docs/` },
			author: { "@id": `${site}/#author` },
		},
		{ "@type": "Person", "@id": `${site}/#author`, name: "Yar Kravtsov", url: "https://github.com/yarlson" },
	],
};

const wrap = "mx-auto w-full max-w-6xl px-6 sm:px-10 lg:px-16";
const chapter = "py-[clamp(5rem,11vw,8.5rem)]";
const heading = "max-w-[24ch] text-balance text-[clamp(1.875rem,3.6vw,2.875rem)] font-[560] leading-[1.1] tracking-[-0.035em]";
const lead = "mt-5 max-w-[58ch] text-pretty text-lg text-ink-2";
const visual = "mt-[clamp(2.5rem,5vw,4rem)]";
const secondaryButton =
	"inline-flex min-h-12 items-center justify-center rounded-[0.625rem] border border-line-strong px-5 text-[0.9375rem] font-[550] transition-colors hover:bg-hover active:bg-pressed";
const block = "rounded-xl border border-line bg-fill";
const link = "underline decoration-line-strong underline-offset-[3px] transition-colors hover:text-ink";

const taskProofs = [
	{ title: "The lead decides.", text: "A task in the inbox waits for the lead's decision. The lead has 30 minutes by default, and you set the time per team. After that, the task comes to you." },
	{ title: "Members do the steps.", text: "Each step has a brief, acceptance criteria and one owner. Steps that do not depend on each other can run at the same time when different members own them." },
	{ title: "Another member reviews.", text: "When your rules ask for a check, a second member reviews each step. While it reviews, Handful denies it Edit and Write. Every third request for changes blocks the step, and the lead decides." },
	{ title: "Whoever asked approves.", text: "The lead closes the task with a result. You approve your tasks or ask for changes. Teams send tasks to each other the same way." },
];

const decideProofs = [
	{ title: "Approval cards.", text: "Allow once, always allow that tool for that bot, or deny. A card that you do not answer expires after 4½ minutes." },
	{ title: "Needs you.", text: "Results to approve, decisions that a lead did not make in time, tasks that are stuck, and budgets near or at their limit. Waiting for you lists the chats where a bot waits for you: an open approval card, a question or a paused task." },
	{ title: "A daily budget.", text: "Set how many turns a team can use per day. At the limit it pauses until midnight or until you raise the limit." },
	{ title: "From your phone.", text: "Pair a phone through your own Cloudflare Tunnel or Tailscale to read, chat or approve once. A phone never chooses Always allow." },
];

const botProofs = [
	{ title: "Memory.", text: "Facts from you or the bot, kept across conversations. You can read them, add one and forget one." },
	{ title: "Routines.", text: "A prompt on a schedule, in your local time. Make and edit them in the Routines tab." },
	{ title: "Skills.", text: "Saved procedures that every bot can run with /name." },
	{ title: "Artifacts.", text: "Plans, reviews and reports that bots save for each other. All of your bots can read them." },
];

const ownProofs = [
	{ title: "Your subscription.", text: "Each turn runs the Claude Code CLI on your machine, signed in by you." },
	{ title: "Your files.", text: "The SQLite database and every bot's folder are in ~/.handful." },
	{ title: "One call home.", text: "By itself, Handful goes online once a day, to look for a new release on GitHub. You can turn that off." },
	{ title: "Your account on GitHub.", text: "Bots run as your user. Their commits and pull requests come from your account." },
];

const limitProofs = [
	{ title: "Not a sandbox.", text: "Bots run as your user. A command that you approve can do anything that you can do." },
	{ title: "Not a shared server.", text: "Handful has no login. One person runs it on their own computer." },
	{ title: "Not offline.", text: "Every turn runs Claude Code, which talks to Anthropic." },
	{ title: "Not for Windows.", text: "Handful runs on macOS and Linux." },
];

const changeProofs = [
	{ title: "Change the UI", text: "React and Tailwind, in ui/. Start the server, then run npm run dev there and edit." },
	{ title: "Change how bots run", text: "One Go package, internal/agent, starts Claude Code and gives the bots their tools." },
	{ title: "Ship your own build", text: "make app builds the Mac app. The license lets you share it." },
];

const folder = [
	{ name: "bots/", dir: true },
	{ name: "teams/", dir: true },
	{ name: "AGENTS.md", dir: false },
	{ name: "connectors.json", dir: false },
	{ name: "config.json", dir: false },
];

const forkCommands = ["gh repo fork yarlson/handful --clone", "cd handful && mise install && make build", "./bin/handful"];

const numbers = [
	{ value: "152", label: "pull requests merged" },
	{ value: "34", label: "releases" },
	{ value: "57 of 129", label: "pull requests from #54 on where the reviewer bot asked for changes" },
	{ value: "10", label: "days, 7 to 16 November 2026" },
];
---

<Layout title={title} description={description}>
	<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
	<Header />

	<main>
		<!-- 1. Hero -->
		<section class={`${wrap} flex flex-col items-center pb-[clamp(3.5rem,11vh,7rem)] pt-[clamp(1.5rem,6vh,4.5rem)] text-center`}>
			<Mark id="hero-mark" size="clamp(6rem, 14vmin, 7rem)" variant="tile" />
			<HeroMarkMotion />
			<h1 class="mt-[clamp(1.25rem,3vh,1.75rem)] max-w-[20ch] text-balance text-[clamp(2.25rem,5.2vw,4rem)] font-[560] leading-[1.06] tracking-[-0.045em]">
				A team of bots does the work. A second bot reviews it. You approve it.
			</h1>
			<p class="mt-5 max-w-[56ch] text-pretty text-[clamp(1.0625rem,1.5vw,1.1875rem)] text-ink-2">
				Handful is an open-source app for your Mac or Linux machine. You give a team a task and write its rules, for example "Tests pass, and another member reviews each change." The lead splits the task into steps, the members do them, and the result waits for your approval. Handful runs Claude Code on your own subscription.
			</p>
			<div class="mt-10 flex w-full justify-center">
				<Install />
			</div>
			<p class="mt-6 text-sm font-[550] text-ink-2">
				Handful builds Handful: 152 pull requests merged and 34 releases from 7 to 16 November 2026. <a href="/built-with-handful/" class={link}>See how.</a>
			</p>
			<Shot
				class="mt-[clamp(2.5rem,5vw,4rem)] w-full text-left"
				light={teamLight}
				dark={teamDark}
				mobileLight={teamMLight}
				mobileDark={teamMDark}
				alt="The Web app team at work: the lead's plan in the chat, and the Work tab with the Now task Add a CSV export to reports, one step done, one in review and one to do"
			/>
		</section>

		<!-- 2. How a task moves -->
		<section class={`bg-band ${chapter}`}>
			<div class={wrap}>
				<h2 class={heading}>
					Every task goes through a lead. <span class="text-ink-2">Each step has one owner and can have a reviewer.</span>
				</h2>
				<p class={lead}>
					A task from another team or from a member lands in the team's inbox. So does your own task, unless you start it at once. The lead takes a task, asks its sender a question, puts it off, passes it to another team or pushes it back with a reason. Then the lead splits it into steps.
				</p>
				<Shot
					class={visual}
					light={inboxLight}
					dark={inboxDark}
					mobileLight={inboxMLight}
					mobileDark={inboxMDark}
					alt="The Web app team's inbox: a task from you with the time to decide by, and a task from Mobile whose clock is paused while Web Lead waits for an answer"
				/>
				<div class="mt-4 grid gap-4 md:grid-cols-[minmax(0,2fr)_minmax(0,5fr)] md:items-start">
					<Shot
						light={reviewLight}
						dark={reviewDark}
						sizes="(min-width: 48rem) 18rem, calc(100vw - 3rem)"
						alt="A step in review: Reviewer asked Developer for changes in round 1, because the export stops at 10,000 rows"
					/>
					<p class="max-w-[52ch] text-pretty text-base text-ink-2 md:pt-4">The reviewer passes a step or asks for changes. You read every round in the step's history.</p>
				</div>
				<Proofs items={taskProofs} />
			</div>
		</section>

		<!-- 3. You decide -->
		<section class={chapter}>
			<div class={wrap}>
				<h2 class={heading}>
					You decide what runs and what counts as done. <span class="text-ink-2">Handful asks, then waits.</span>
				</h2>
				<p class={lead}>
					A bot reads files and searches the web without asking. Before it runs a command, changes a file or calls a connector tool, it shows you a card with the command or the diff. Two lists hold everything that waits for you.
				</p>
				<Shot
					class={visual}
					light={approvalLight}
					dark={approvalDark}
					mobileLight={approvalMLight}
					mobileDark={approvalMDark}
					alt="Developer asks before it edits a file: the card shows the path and the diff, with the buttons Allow once, Always allow Edit and Deny"
				/>
				<Shot
					class="mt-4"
					light={needsYouLight}
					dark={needsYouDark}
					mobileLight={needsYouMLight}
					mobileDark={needsYouMDark}
					sizes="(min-width: 72rem) 64rem, calc(100vw - 3rem)"
					alt="Across teams: Needs you asks you to approve that Add a CSV export to reports is done in Web app"
				/>
				<Proofs items={decideProofs} />
			</div>
		</section>

		<!-- 4. Handful builds Handful -->
		<section class={`bg-band ${chapter}`}>
			<div class={wrap}>
				<h2 class={heading}>
					Handful builds Handful. <span class="text-ink-2">Four teams of bots and one person.</span>
				</h2>
				<p class={lead}>
					Teams of bots in its maker's own Handful write the specs, the code and the reviews of this app. A product team sends a spec to a dev team as a task. A reviewer bot reads the pull requests before they are merged, and a release bot merges and releases what is approved. One person sends the tasks and approves the results. It is a small software factory, and every pull request and every review comment is on GitHub for you to read.
				</p>
				<dl class={`${visual} grid gap-8 border-y border-line py-10 sm:grid-cols-2 lg:grid-cols-4`}>
					{
						numbers.map((n) => (
							<div>
								<dt class="sr-only">{n.label}</dt>
								<dd class="text-[clamp(2.5rem,5vw,3.5rem)] font-[560] leading-none tracking-[-0.045em] [font-variant-numeric:tabular-nums]">{n.value}</dd>
								<dd class="mt-2 text-pretty text-base text-ink-2">{n.label}</dd>
							</div>
						))
					}
				</dl>
				<p class="mt-6 max-w-[62ch] text-pretty text-base text-ink-2">
					One request on 13 November: a one-line message at 13:23, a reviewed spec, two pull requests that the reviewer sent back once each, and release v0.21.0 at 16:47.
				</p>
				<p class="mt-4 max-w-[62ch] text-sm text-ink-3">
					Counted on GitHub at release v0.22.0, 16 November 2026. A bot reviewed 124 of the 129. The bots work through their maker's GitHub account, so GitHub shows one author. Each review is a comment on the pull request.
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a href="/built-with-handful/" class={secondaryButton}>How the teams work</a>
					<a href="https://github.com/yarlson/handful/pulls?q=is%3Apr+is%3Amerged" class={secondaryButton}>The pull requests</a>
				</div>
			</div>
		</section>

		<!-- 5. A bot keeps its context -->
		<section class={chapter}>
			<div class={wrap}>
				<h2 class={heading}>
					A bot keeps its chat, its memory and its folder. <span class="text-ink-2">A team keeps its lessons.</span>
				</h2>
				<p class={lead}>
					Close the app and come back later. Each bot still has its conversation, its files and the facts that it saved. After you approve a task, the lead is asked to save up to 5 lessons in the team's memory.
				</p>
				<Shot
					class={visual}
					light={botLight}
					dark={botDark}
					mobileLight={botMLight}
					mobileDark={botMDark}
					alt="A bot's chat: a group of three tool calls with the diff of an edit open, a code block with its header, and the bot's memory in the panel"
				/>
				<Proofs items={botProofs} />
			</div>
		</section>

		<!-- 6. Your own subscription -->
		<section class={`bg-band ${chapter}`}>
			<div class={wrap}>
				<h2 class={heading}>
					Runs Claude Code on your own subscription. <span class="text-ink-2">Nothing to sell you.</span>
				</h2>
				<p class={lead}>
					You install Claude Code and sign in to it yourself, with your Claude subscription or an API key. Handful starts it on your machine for each turn and never touches your login. Handful sells no tokens and adds no fees, and there is no Handful account and no Handful cloud. The rest is a server and a folder on your disk.
				</p>
				<p class="mt-3 max-w-[62ch] text-sm text-ink-3">
					What your plan includes is between you and Anthropic. For company code, sign in to Claude Code with the plan or API key that your company uses.
				</p>
				<p class="mt-1 max-w-[62ch] text-sm text-ink-3">
					Claude Code sends your prompts and the model's answers to Anthropic. <a href="/security/" class={link}>Security</a> says what else leaves your computer.
				</p>
				<div class={`${visual} ${block} max-w-xl p-5 font-mono text-[0.875rem] leading-relaxed`} role="img" aria-label="The ~/.handful folder: bots, teams, AGENTS.md, connectors.json and config.json">
					<p class="font-[550]">~/.handful</p>
					<ul class="mt-2 space-y-1 pl-5">
						{
							folder.map((entry) => (
								<li class={entry.dir ? "" : "text-ink-2"}>
									<span class="text-ink-3" aria-hidden="true">├─ </span>
									{entry.name}
								</li>
							))
						}
					</ul>
				</div>
				<Proofs items={ownProofs} />
			</div>
		</section>

		<!-- 7. What Handful is not -->
		<section class={chapter}>
			<div class={wrap}>
				<h2 class={heading}>What Handful is not.</h2>
				<p class={lead}>Know the limits before you install it.</p>
				<Proofs items={limitProofs} />
				<p class="mt-8 text-base">
					<a href="/security/" class={link}>Security has the whole list</a>
				</p>
			</div>
		</section>

		<!-- 8. Change it -->
		<section class={`bg-band ${chapter}`}>
			<div class={wrap}>
				<h2 class={heading}>
					Don't like something? Change it. <span class="text-ink-2">The code is MIT.</span>
				</h2>
				<div class={`${visual} max-w-2xl`}>
					<pre class={`${block} whitespace-pre-wrap px-5 py-4 font-mono text-[0.875rem] leading-relaxed [overflow-wrap:anywhere]`}><code>{forkCommands.map((c) => <span class="block"><span class="select-none text-ink-3">$ </span>{c}</span>)}</code></pre>
					<p class="mt-3 text-sm text-ink-3">Building needs mise. Then open 127.0.0.1:7777.</p>
				</div>
				<Proofs items={changeProofs} />
				<p class="mt-8 text-base text-ink-2">If this project stops, you still have the code and your data.</p>
				<div class="mt-10 flex flex-col gap-3 sm:flex-row">
					<a
						href="https://github.com/yarlson/handful/fork"
						class="inline-flex min-h-12 items-center justify-center rounded-[0.625rem] border border-button bg-button px-5 text-[0.9375rem] font-[550] text-button-ink transition-colors hover:border-button-hover hover:bg-button-hover"
					>
						Fork it
					</a>
					<a href="https://github.com/yarlson/handful" class={secondaryButton}>Read the source</a>
				</div>
			</div>
		</section>

		<!-- 9. Closing -->
		<section class={chapter}>
			<div class={`${wrap} flex flex-col items-center gap-6 text-center`}>
				<Mark id="closing-mark" size="4.5rem" variant="tile-small" />
				<h2 class={heading}>Start with one team and one task.</h2>
				<p class="max-w-[52ch] text-pretty text-lg text-ink-2">
					Handful is free and open source. Install it, sign in to Claude Code, and choose Software team in Builder's first message.
				</p>
				<div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
					<a
						href={macDownloadUrl}
						class="inline-flex min-h-12 items-center justify-center gap-2 rounded-[0.625rem] border border-button bg-button px-5 text-[0.9375rem] font-[550] text-button-ink transition-colors hover:border-button-hover hover:bg-button-hover"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true" class="size-[1.0625rem] fill-none stroke-current stroke-[1.75] [stroke-linecap:round] [stroke-linejoin:round]">
							<path d="M12 4v11M7 10.5l5 5 5-5M5 19.5h14"></path>
						</svg>
						Download for macOS
					</a>
					<a href="https://github.com/yarlson/handful#install-and-start" class={secondaryButton}>Linux, or build from source</a>
				</div>
				<p class="text-sm text-ink-3">
					<a href="https://github.com/yarlson/handful/releases/latest" class="underline decoration-line-strong underline-offset-[3px] transition-colors hover:text-ink">Latest release</a> · MIT License
				</p>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
